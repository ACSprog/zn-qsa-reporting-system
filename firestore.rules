rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }

    // Signed in with the second step (authenticator app code) in this session
    function has2fa() {
      return 'sign_in_second_factor' in request.auth.token.firebase;
    }

    // settings/security.require2fa (set by `npm run setup:firebase -- --enable-2fa`)
    function twoFactorOk() {
      return !exists(/databases/$(database)/documents/settings/security)
        || get(/databases/$(database)/documents/settings/security).data.get('require2fa', false) != true
        || has2fa();
    }

    // Backstop for the CMS session limit: refuse sessions signed in more than 12 hours ago
    // (the CMS itself signs people out after 8 hours by default)
    function sessionFresh() {
      return request.time.toMillis() < (request.auth.token.auth_time + 43200) * 1000;
    }

    // An unblocked CMS user (blocked users have enabled == false) who passed 2FA if required
    function isAdmin() {
      return isSignedIn()
        && exists(/databases/$(database)/documents/admins/$(request.auth.uid))
        && get(/databases/$(database)/documents/admins/$(request.auth.uid)).data.get('enabled', true) != false
        && twoFactorOk()
        && sessionFresh();
    }

    // Legacy marker: anyone in qsaAdmins is treated as a Manager
    function isQsaAdmin() {
      return isSignedIn() && exists(/databases/$(database)/documents/qsaAdmins/$(request.auth.uid));
    }

    // Privilege levels, stored as admins/{uid}.role:
    //   viewer     - read reports only
    //   officer    - also update status/notes and REQUEST deletion (default for docs without a role)
    //   manager    - also approve deletions / archive / restore, see reporter identities,
    //                manage Viewers and Officers
    //   superadmin - everything, including creating / promoting / blocking / removing Managers
    function myRole() {
      return get(/databases/$(database)/documents/admins/$(request.auth.uid)).data.get('role', 'officer');
    }

    function isSuperAdmin() {
      return isAdmin() && myRole() == 'superadmin';
    }

    function isManager() {
      return isAdmin() && (isQsaAdmin() || myRole() in ['manager', 'superadmin']);
    }

    // Roles a plain Manager may hand out or manage
    function juniorRole(role) {
      return role in ['viewer', 'officer'];
    }

    function isLegacyManager(uid) {
      return exists(/databases/$(database)/documents/qsaAdmins/$(uid));
    }

    function isOfficer() {
      return isAdmin() && (isManager() || myRole() == 'officer');
    }

    // All report collections the CMS reads ('incident' and 'accident' are the old separate
    // forms, kept for existing records; new cases use the combined 'occurrence' form)
    function isReportForm(form) {
      return form in ['hazard', 'occurrence', 'incident', 'accident', 'concern'];
    }

    // Forms reporters can submit new cases to
    function isActiveReportForm(form) {
      return form in ['hazard', 'occurrence', 'concern'];
    }

    // Role documents written by Managers. Only these fields are allowed.
    function validRoleDoc() {
      let d = request.resource.data;
      return d.keys().hasOnly(['enabled', 'email', 'name', 'role', 'mustChangePassword', 'tempPasswordHash', 'createdAt', 'createdBy', 'pendingAction'])
        && d.enabled is bool
        && d.email is string && d.email.size() <= 320
        && d.get('role', 'officer') in ['viewer', 'officer', 'manager', 'superadmin']
        && d.get('mustChangePassword', false) is bool
        && d.get('name', '') is string && d.get('name', '').size() <= 200
        && d.get('tempPasswordHash', '') is string && d.get('tempPasswordHash', '').size() <= 128;
    }

    function adminChanges() {
      return request.resource.data.diff(resource.data).affectedKeys();
    }

    function isSuperAdminDoc(data) {
      return data.get('role', 'officer') == 'superadmin';
    }

    // ---- Two-person rule for Super Admin accounts ----
    // Another Super Admin can only REQUEST to remove, block or change the level of a Super Admin
    // (admins/{uid}.pendingAction). The Super Admin concerned must approve it themselves.

    // A Super Admin asking (or re-asking) another Super Admin to confirm an action
    function isPendingActionRequest(uid) {
      let pa = request.resource.data.pendingAction;
      return isSuperAdmin() && request.auth.uid != uid
        && isSuperAdminDoc(resource.data)
        && adminChanges().hasOnly(['pendingAction'])
        && (!('pendingAction' in resource.data) || resource.data.pendingAction.requestedBy == request.auth.uid)
        && pa.keys().hasOnly(['type', 'newRole', 'requestedBy', 'requestedByEmail', 'requestedAt'])
        && pa.type in ['remove', 'block', 'role']
        && (pa.type != 'role' || pa.get('newRole', '') in ['viewer', 'officer', 'manager'])
        && pa.requestedBy == request.auth.uid
        && pa.requestedByEmail is string && pa.requestedByEmail.size() <= 320
        && pa.requestedAt == request.time;
    }

    // The requester withdrawing their own request
    function isPendingActionCancel(uid) {
      return isSuperAdmin() && request.auth.uid != uid
        && adminChanges().hasOnly(['pendingAction'])
        && !('pendingAction' in request.resource.data)
        && resource.data.pendingAction.requestedBy == request.auth.uid;
    }

    // The request still comes from an active Super Admin
    function pendingRequesterIsSuperAdmin() {
      let requester = get(/databases/$(database)/documents/admins/$(resource.data.pendingAction.requestedBy)).data;
      return requester.get('role', '') == 'superadmin' && requester.get('enabled', true) != false;
    }

    // The Super Admin concerned answering a request about their own account
    function isOwnPendingActionAnswer(uid) {
      let pa = resource.data.pendingAction;
      let after = request.resource.data;
      return isSignedIn() && request.auth.uid == uid
        && 'pendingAction' in resource.data
        && !('pendingAction' in after)
        && (
          // decline
          adminChanges().hasOnly(['pendingAction'])
          // approve block
          || (pa.type == 'block' && pendingRequesterIsSuperAdmin()
            && adminChanges().hasOnly(['pendingAction', 'enabled']) && after.enabled == false)
          // approve change of level (always a step down from Super Admin)
          || (pa.type == 'role' && pendingRequesterIsSuperAdmin()
            && adminChanges().hasOnly(['pendingAction', 'role']) && after.role == pa.newRole)
        );
    }

    // CMS users. Managers add, change, block and remove Viewers and Officers; Super Admins can
    // do this for everyone, except that changes to another Super Admin need that Super Admin's
    // confirmation (see above). Nobody can change or remove their own access directly.
    match /admins/{uid} {
      allow read: if isSignedIn() && (request.auth.uid == uid || isManager());
      allow create: if isManager() && request.auth.uid != uid && validRoleDoc()
        && !('pendingAction' in request.resource.data)
        && (isSuperAdmin() || juniorRole(request.resource.data.get('role', 'officer')));
      allow update: if isManager() && request.auth.uid != uid && validRoleDoc()
        && !adminChanges().hasAny(['pendingAction'])
        && ((isSuperAdmin() && !isSuperAdminDoc(resource.data))
          || (juniorRole(request.resource.data.get('role', 'officer'))
            && juniorRole(resource.data.get('role', 'officer'))
            && !isLegacyManager(uid)));
      // Unblocking a Super Admin needs no confirmation (they can't sign in to give it)
      allow update: if isSuperAdmin() && request.auth.uid != uid && isSuperAdminDoc(resource.data)
        && adminChanges().hasOnly(['enabled']) && request.resource.data.enabled == true;
      allow update: if isPendingActionRequest(uid) || isPendingActionCancel(uid) || isOwnPendingActionAnswer(uid);
      // A user may only clear their own "must change password" flag (and the temporary
      // password fingerprint) once they use a password of their own
      allow update: if isSignedIn() && request.auth.uid == uid
        && adminChanges().hasOnly(['mustChangePassword', 'tempPasswordHash'])
        && request.resource.data.mustChangePassword == false
        && !('tempPasswordHash' in request.resource.data);
      allow delete: if isManager() && request.auth.uid != uid
        && !isSuperAdminDoc(resource.data)
        && (isSuperAdmin() || (juniorRole(resource.data.get('role', 'officer')) && !isLegacyManager(uid)));
      // A Super Admin approving another Super Admin's request to remove them
      allow delete: if isSignedIn() && request.auth.uid == uid
        && isSuperAdminDoc(resource.data)
        && resource.data.get('pendingAction', {'type': ''}).type == 'remove'
        && pendingRequesterIsSuperAdmin();
    }

    // Legacy Manager marker (older setups). New code stores the role on admins/{uid}.
    // Super Admins may remove other people's; anyone may remove their own (it only lowers access).
    match /qsaAdmins/{uid} {
      allow read: if isSignedIn() && (request.auth.uid == uid || isManager());
      allow create, update: if false;
      allow delete: if (isSuperAdmin() && request.auth.uid != uid) || (isSignedIn() && request.auth.uid == uid);
    }

    // Security settings: readable by signed-in users so the CMS knows whether 2FA is required.
    // Super Admins can switch the 2FA requirement on or off from the CMS. Turning it ON is only
    // allowed from a session that itself used 2FA, which proves authenticator codes work for this
    // project (otherwise everyone could be locked out). The setup script can always change it.
    match /settings/{doc} {
      allow read: if isSignedIn();
      allow create, update: if doc == 'security'
        && isSuperAdmin()
        && request.resource.data.keys().hasOnly(['require2fa', 'updatedBy', 'updatedAt'])
        && request.resource.data.require2fa is bool
        && (request.resource.data.require2fa == false || has2fa());
      allow delete: if false;
    }

    // Announcement queue (e.g. scheduled maintenance): shown to everyone, public forms too,
    // so anyone can read; only Super Admins can write.
    function validAnnouncement() {
      let d = request.resource.data;
      return d.keys().hasOnly(['active', 'message', 'level', 'showFrom', 'showUntil', 'createdAt', 'updatedBy', 'updatedAt'])
        && d.active is bool
        && d.message is string && d.message.size() > 0 && d.message.size() <= 500
        && d.level in ['info', 'notice', 'warning', 'critical']
        && (!('showFrom' in d) || d.showFrom == null || d.showFrom is timestamp)
        && (!('showUntil' in d) || d.showUntil == null || d.showUntil is timestamp);
    }

    match /announcements/{id} {
      allow read: if true;
      allow create, update: if isSuperAdmin() && validAnnouncement();
      allow delete: if isSuperAdmin();
    }

    function reportChanges() {
      return request.resource.data.diff(resource.data).affectedKeys();
    }

    function validStatus() {
      return request.resource.data.status in ['New', 'Under review', 'Action required', 'Closed'];
    }

    // An Officer asking a Manager to delete (archive) a report
    function isNewDeletionRequest() {
      let dr = request.resource.data.deletionRequest;
      return reportChanges().hasOnly(['deletionRequest'])
        && resource.data.deleted == false
        && resource.data.get('deletionRequest', {'status': 'none'}).status != 'pending'
        && dr.keys().hasOnly(['status', 'requestedBy', 'requestedByEmail', 'requestedAt', 'reason'])
        && dr.status == 'pending'
        && dr.requestedBy == request.auth.uid
        && dr.requestedAt == request.time
        && dr.reason is string && dr.reason.size() > 0 && dr.reason.size() <= 1000;
    }

    // Report collections (hazard, occurrence, concern; plus old incident / accident records)
    match /{form}/{reportId} {
      allow create: if isActiveReportForm(form)
        && request.resource.data.reporting in ['Named', 'Confidential', 'Anonymous']
        && request.resource.data.status == 'New'
        && request.resource.data.deleted == false
        && request.resource.data.evidenceCount is number
        && request.resource.data.evidenceCount >= 0
        && request.resource.data.evidenceCount <= 5
        && request.resource.data.reportId == reportId
        && request.resource.data.createdAt == request.time
        && request.resource.data.keys().size() <= 60
        // identity fields must never be stored on the report document
        && !request.resource.data.keys().hasAny(['name', 'department', 'position', 'contact'])
        // deletion requests can only be added later by CMS Officers
        && !('deletionRequest' in request.resource.data);

      allow read: if isAdmin() && isReportForm(form);

      // Viewers: no updates. Officers: status/notes, or a deletion request.
      // Managers: status/notes, archive/restore (deleted) and deciding deletion requests.
      allow update: if isReportForm(form) && validStatus() && (
        (isManager()
          && reportChanges().hasOnly(['status', 'notes', 'deleted', 'deletionRequest', 'reclassifiedTo', 'reclassification'])
          && request.resource.data.deleted is bool
          // Moving a case to another report type keeps its number; only current types allowed
          && request.resource.data.get('reclassifiedTo', 'hazard') in ['hazard', 'occurrence', 'concern'])
        || (isOfficer() && reportChanges().hasOnly(['status', 'notes']))
        || (isOfficer() && isNewDeletionRequest())
      );

      allow delete: if false;

      // Evidence subcollection (1 to 5 files per report)
      match /evidence/{n} {
        allow create: if isActiveReportForm(form)
          && n in ['1', '2', '3', '4', '5']
          && request.resource.data.keys().hasOnly(['name', 'contentType', 'size', 'data', 'order', 'createdAt'])
          && request.resource.data.contentType in ['image/jpeg', 'application/pdf']
          && request.resource.data.data is string
          && request.resource.data.data.size() < 850000
          && request.resource.data.createdAt == request.time;
        allow read: if isAdmin();
        allow update, delete: if false;
      }
    }

    // Reporter identities collection (isolated from report documents)
    match /identities/{reportId} {
      allow create: if !exists(/databases/$(database)/documents/identities/$(reportId))
        && request.resource.data.keys().hasOnly(['name', 'department', 'position', 'contact', 'createdAt', 'reporting', 'reportId'])
        && request.resource.data.reporting in ['Named', 'Confidential']
        && request.resource.data.reportId == reportId
        && request.resource.data.createdAt == request.time
        && request.resource.data.name is string && request.resource.data.name.size() <= 300
        && request.resource.data.department is string && request.resource.data.department.size() <= 300
        && request.resource.data.position is string && request.resource.data.position.size() <= 300
        && request.resource.data.contact is string && request.resource.data.contact.size() <= 300;
      allow read: if isManager();
      allow update, delete: if false;
    }
  }
}
