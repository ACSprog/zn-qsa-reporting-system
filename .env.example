# Zambia Airways Safety Reporting System Environment Configuration
# Copy this file to .env.local or .env for local development

# Firebase Client Configuration (Spark Plan - Auth & Firestore only)
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# Power Automate Flow HTTP Webhook Endpoints
VITE_FLOW_URL_HAZARD=
VITE_FLOW_URL_INCIDENT=
VITE_FLOW_URL_ACCIDENT=
VITE_FLOW_URL_CONCERN=
VITE_FLOW_TOKEN=

# Microsoft Entra ID (Azure AD) MSAL & Graph Configuration
VITE_MSAL_CLIENT_ID=
VITE_MSAL_TENANT_ID=
VITE_WORKBOOK_BASE=/me/drive/root:/Safety Reports.xlsx:
VITE_GRAPH_SCOPES=Files.ReadWrite.All,User.Read
VITE_EVIDENCE_DRIVE_BASE=/sites/{site-id}/drive/root:/Safety Evidence
VITE_EVIDENCE_FOLDER_URL=https://{tenant}.sharepoint.com/sites/{site}/Shared Documents/Safety Evidence
