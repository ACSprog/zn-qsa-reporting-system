# Zambia Airways Safety Reporting System Environment Configuration
# Copy this file to .env.local or .env for local development

# Local development with the Firebase Emulator Suite (no cloud project needed).
# Set to true, then run `npm run emulators` and `npm run seed:emulators` (see README).
# Ignored in production builds.
VITE_USE_FIREBASE_EMULATORS=false

# CMS session limits (optional): sign out after N idle minutes (default 15) and
# require signing in again after N hours (default 8, max 12)
VITE_CMS_IDLE_MINUTES=
VITE_CMS_MAX_SESSION_HOURS=

# Firebase Client Configuration (Spark Plan - Auth & Firestore only)
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# Power Automate Flow HTTP Webhook Endpoints
VITE_FLOW_URL_HAZARD=
VITE_FLOW_URL_INCIDENT=
VITE_FLOW_URL_ACCIDENT=
VITE_FLOW_URL_CONCERN=
# Welcome emails for new CMS users (docs/POWER_AUTOMATE.md, section 5)
VITE_FLOW_URL_ACCOUNTS=
VITE_FLOW_TOKEN=

# SharePoint evidence folder (web URL, used to build the folder link in Excel)
VITE_EVIDENCE_FOLDER_URL=https://{tenant}.sharepoint.com/sites/{site}/Shared Documents/Safety Evidence
